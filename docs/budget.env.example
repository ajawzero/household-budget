# Template for your budget.env file (PLAN 9.4).
# Keep it mode 600. Pass it to the container with --env-file.
# Fake values only. Never put real keys in this example or anywhere in git.
# One VAR=value per line. No quotes, no spaces around "=".

# Time zone for logs. The app's own dates and the 03:15 backup always use America/Chicago.
TZ=America/Chicago

# Paths inside the container. Mount your host folders here:
#   /data/db       <- budget-private/db, by its cache pool path (/mnt/<pool>/budget-private/db)
#   /data/config   <- /mnt/user/budget-private/config (read only)
#   /data/backups  <- /mnt/user/budget-backups
#   /data/import   <- /mnt/user/appdata/budget-app/import (read only)
BUDGET_DB_PATH=/data/db/budget.db
BUDGET_IMPORT_DIR=/data/import
BUDGET_BACKUP_DIR=/data/backups

# Personal subscription names and employer terms. Empty means no private lists.
BUDGET_PRIVATE_RULES=/data/config/private_rules.json

# Host names the app answers to, comma separated. 127.0.0.1 works for /healthz only.
BUDGET_ALLOWED_HOSTS=budget.home.example

# The HTTPS port browsers use to reach your proxy, when it is not 443. The app's
# address is then https://budget.home.example:1443. Leave it out for 443.
BUDGET_PUBLIC_PORT=1443

# Optional. The defaults are right on the server.
# Seconds between import folder checks:
# BUDGET_IMPORT_POLL_SECONDS=60
# 1 turns on plain-HTTP cookies, API docs and localhost. Only scripts/dev.sh sets it.
# Must stay 0 or unset on the server:
# BUDGET_DEV=0
# Set by the image. Change only if the image layout changes:
# BUDGET_STATIC_DIR=/app/static
# BUDGET_CATEGORIES_FILE=/app/schema/categories.json
# BUDGET_REDACTION_FILE=/app/schema/redaction.json
# Demo mode, also set by the image: the sample runs it is built from, and the demo
# database folder. A runs folder that does not exist (for example /app/demo/off)
# turns demo off:
# BUDGET_DEMO_RUNS=/app/demo/runs
# BUDGET_DEMO_DIR=/tmp/budget-demo

# Keys. An empty key turns its feature off.
# Real keys live only in the server file, never on the Mac or in git.
# The app also reads them as BUDGET_TIINGO_API_KEY and BUDGET_ANTHROPIC_API_KEY.
# Phase 5: market prices.
TIINGO_API_KEY=
# Phase 6: Claude API. AI stays off while this is empty.
ANTHROPIC_API_KEY=
